# Copy to .env. Never put credentials in files starting with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: another provider that supports OpenAI Chat Completions.
OPENAI_BASE_URL=https://api.openai.com/v1
# Required to enable AI. Choose a long private password for this personal app.
APP_PASSWORD=
PORT=4173
HOST=127.0.0.1
# Set true when deployed behind an HTTPS reverse proxy.
COOKIE_SECURE=false
